# Renders config/ddns.json.template -> data/ddns/config.json from .env at
# container start, so DDNS credentials only need to be maintained in one place.
FROM alpine:3.20

RUN apk add --no-cache gettext

COPY docker/render-ddns-config.sh /usr/local/bin/render-ddns-config.sh
RUN chmod +x /usr/local/bin/render-ddns-config.sh

ENTRYPOINT ["/usr/local/bin/render-ddns-config.sh"]
