# proxyfin environment configuration
DOMAIN=
SUBDOMAIN=
HOSTED_ZONE_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: override ddns-updater's check interval / anti-rate-limit cooldown
# (defaults: 3600s / 300s). Useful to shorten temporarily while iterating;
# leave unset for normal operation.
# DDNS_PERIOD=3600s
# DDNS_UPDATE_COOLDOWN_PERIOD=300s

# Optional: which DNS record type(s) to publish (default: "ipv4 or ipv6").
# Set to "ipv4" or "ipv6" to publish only one, e.g. if IPv6 is unreliable
# (Windows privacy-extension temporary addresses churning, ISP not routing
# IPv6, etc).
# IP_VERSION=ipv4
